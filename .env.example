# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/ironman?schema=public"

# ── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -hex 32
NEXTAUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# ── Admin (used by prisma/seed.ts on first seed) ──────────────
ADMIN_EMAIL="admin@ironman.co.il"
ADMIN_PASSWORD="ChangeMe123!"

# ── Public site ───────────────────────────────────────────────
# Production: https://theironman.co.il
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Default WhatsApp for contact form (גיא בלולו)
NEXT_PUBLIC_WHATSAPP_NUMBER="972507562842"

# ── Deploy overrides (optional, used by deploy/deploy.sh) ───────
# FRONTEND_HOST=root@84.46.253.85
# IRONMAN_DOMAIN=theironman.co.il
# IRONMAN_PORT=3012
